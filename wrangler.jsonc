{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image24",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  // After image24.in is attached to Cloudflare, you can enable this: 
  // "routes": [{"pattern":"image24.in","custom_domain":true}],
  "assets": {
    "html_handling": "auto-trailing-slash",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image24-db",
      "database_id": "37ce9012-b0e5-4201-a79c-682900b34288"
    }
  ],
  
}
